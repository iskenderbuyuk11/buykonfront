# Server-side only — never commit, never ship to browser
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Virtual try-on (geyim) — şəkil modeli. Free tier-də yoxdur; Billing lazımdır.
# Default: gemini-3.1-flash-lite-image
# GEMINI_TRYON_MODEL=gemini-3.1-flash-image

# Didit KYC — only these two secrets
# https://business.didit.me
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=

# Java API (OTP admin ilə eyni EmailService / SpaceMail)
# Lokal: http://localhost:8080/api
# Prod: https://api.buykon.com/api
API_BASE=

# Satıcı OTP PHP fallback (Java /auth/email/* 404 olduqda)
SMTP_HOST=mail.spacemail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=buykon@buykon.com
SMTP_PASS=
MAIL_FROM=buykon@buykon.com
MAIL_FROM_NAME=Buykon
# Lokal test: SMTP uğursuz olsa belə kod cavabda (dev_code)
# OTP_DEV_LOG=1

